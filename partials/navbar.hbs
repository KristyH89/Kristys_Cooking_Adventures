{{!--
  Site header: logo + main navigation.
  Usage: {{> navbar active="food"}}  (key from NAV_ITEMS in site.config.js)
  Colours come from the page theme (data-theme on <body>), see src/style.css.
  On small screens the menu collapses behind a toggle button (src/navigation.js).
--}}
<header>
  <div class="w-full bg-white py-6 px-4 flex justify-center">
    <a href="{{route 'index.html'}}" class="block max-w-3xl w-full">
      <img
        src="/images/site/logo-creative-adventures.png"
        alt="Kristy's Creative Adventures – home"
        width="1030"
        height="137"
        class="w-full h-auto"
      />
    </a>
  </div>

  <nav class="site-nav" aria-label="Main">
    <button
      type="button"
      class="site-nav__toggle"
      aria-expanded="false"
      aria-controls="site-nav-menu"
    >
      <span class="site-nav__icon" aria-hidden="true"><span></span></span>
      Menu
    </button>

    <ul id="site-nav-menu" class="site-nav__menu">
      {{#each navItems}}
      <li>
        <a
          href="{{route path}}"
          class="site-nav__link"
          {{#if (eq key ../active)}}aria-current="page"{{/if}}
        >{{label}}</a>
      </li>
      {{/each}}
    </ul>
  </nav>
</header>
