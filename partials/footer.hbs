{{!--
  Site footer with the same links as the main navigation.
  Colours come from the page theme (data-theme on <body>), see src/style.css.
--}}
<footer class="site-footer">
  <nav class="mb-3" aria-label="Footer">
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-lg font-medium px-6">
      {{#each navItems}}
      <li><a href="{{route path}}" class="site-footer__link">{{label}}</a></li>
      {{/each}}
    </ul>
  </nav>

  <p class="site-footer__copy">
    © 2026 🍴 Kristy's Cooking Adventures
  </p>
</footer>
